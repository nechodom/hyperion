{#- ───────────────────────────────────────────────────────────────
   The HTTPS server-block body (headers, WAF, auth, ACME, PHP-FPM
   and the location blocks) is identical for the primary vhost and
   the optional internal-preview vhost — only `server_name` and the
   ssl_certificate pair differ. It's factored into one macro so the
   two blocks can't drift. The per-block `listen` / `server_name` /
   `root` / `index` / `ssl_certificate*` lines stay at the call site
   because they're tiny and differ between the two.

   Askama requires macro/import/extends blocks at the TOP LEVEL of the
   template (never nested inside an {% if %}), so it lives up here and
   is only *called* from the non-maintenance branch below.
   ─────────────────────────────────────────────────────────────── -#}
{% macro https_body(preview) %}
    ssl_protocols TLSv1.2 TLSv1.3;
    ssl_ciphers ECDHE-ECDSA-CHACHA20-POLY1305:ECDHE-RSA-CHACHA20-POLY1305:ECDHE-ECDSA-AES128-GCM-SHA256:ECDHE-RSA-AES128-GCM-SHA256:ECDHE-ECDSA-AES256-GCM-SHA384:ECDHE-RSA-AES256-GCM-SHA384;
    ssl_prefer_server_ciphers on;
    ssl_session_cache shared:SSL:10m;
    ssl_session_timeout 1d;
    # Session tickets off: without key rotation they undercut TLS forward secrecy.
    ssl_session_tickets off;

    # Upload ceiling. Generous headroom (default PHP upload is 64M but an
    # operator can raise upload_max_filesize/post_max_size via the per-site
    # php.ini override / .user.ini) — without this nginx's 1M default would
    # 413 the request before PHP ever sees it.
    client_max_body_size 256m;

    # Restore the real client address when the site is behind Cloudflare's
    # proxy. Without this, every visitor "is" a Cloudflare edge IP — which
    # made the wp-admin allowlist below UNSATISFIABLE on proxied sites (the
    # operator's own address never matches, so /wp-admin/ is a permanent
    # 403), and filled access.log with edge addresses the brute-force
    # scanner then pointlessly banned.
    #
    # Safe to emit unconditionally: set_real_ip_from means CF-Connecting-IP
    # is trusted ONLY when the TCP peer itself is inside these ranges, so a
    # direct visitor cannot spoof it. Non-proxied sites simply never
    # receive a connection from these ranges.
    #
    # Ranges are www.cloudflare.com/ips-{v4,v6}, stable for years, and the
    # SAME list hyperion-core uses to classify a domain as proxied
    # (`is_cloudflare_ipv4` in service.rs) — change either only with the
    # other, or the panel will call a site proxied while nginx does not
    # trust its edge.
    set_real_ip_from 173.245.48.0/20;
    set_real_ip_from 103.21.244.0/22;
    set_real_ip_from 103.22.200.0/22;
    set_real_ip_from 103.31.4.0/22;
    set_real_ip_from 141.101.64.0/18;
    set_real_ip_from 108.162.192.0/18;
    set_real_ip_from 190.93.240.0/20;
    set_real_ip_from 188.114.96.0/20;
    set_real_ip_from 197.234.240.0/22;
    set_real_ip_from 198.41.128.0/17;
    set_real_ip_from 162.158.0.0/15;
    set_real_ip_from 104.16.0.0/13;
    set_real_ip_from 104.24.0.0/14;
    set_real_ip_from 172.64.0.0/13;
    set_real_ip_from 131.0.72.0/22;
    set_real_ip_from 2400:cb00::/32;
    set_real_ip_from 2606:4700::/32;
    set_real_ip_from 2803:f800::/32;
    set_real_ip_from 2405:b500::/32;
    set_real_ip_from 2405:8100::/32;
    set_real_ip_from 2a06:98c0::/29;
    set_real_ip_from 2c0f:f248::/32;
    real_ip_header CF-Connecting-IP;

    {%- if hsts_max_age > 0 %}
    add_header Strict-Transport-Security "max-age={{ hsts_max_age }}; includeSubDomains" always;
    {%- endif %}
    add_header X-Frame-Options "SAMEORIGIN" always;
    add_header X-Content-Type-Options "nosniff" always;
    add_header Referrer-Policy "strict-origin-when-cross-origin" always;
    {%- if fastcgi_cache_enabled %}
    # Cache-status debug header. Declared HERE (server level) and not inside
    # the PHP location: a location-level add_header would REPLACE the whole
    # inherited set, silently dropping HSTS/XFO/nosniff on every PHP response.
    # nginx omits headers whose value is empty, so non-FastCGI responses
    # simply don't carry it.
    add_header X-Cache-Status $upstream_cache_status always;
    {%- endif %}
    server_tokens off;

    {%- if waf_enabled %}
    # ─── WAF-lite (operator-enabled, Settings → Security) ───
    # `if` + `return` is one of the two officially-safe uses of `if`
    # inside a server block. Conservative patterns only — no attempt to
    # be a full ModSecurity ruleset, which would false-positive on
    # legitimate WP traffic.
    # 1. 403 obvious probe query-strings (path traversal, SQLi, RFI).
    if ($args ~* "(\.\./|\.\.%2f|union(\s|\+|%20)+select|base64_(en|de)code\s*\(|/etc/passwd|\beval\s*\(|<script)") {
        return 403;
    }
    # 2. 403 known scanner / vulnerability-probe user-agents.
    if ($http_user_agent ~* "(nikto|sqlmap|nmap|masscan|jorgee|zgrab|wpscan|libredtail|fuzz)") {
        return 403;
    }
    {%- endif %}

    access_log {{ logs_dir }}/access.log;
    error_log  {{ logs_dir }}/error.log;

    {%- if basic_auth_enabled %}
    # Site-wide HTTP basic auth — agent writes the .htpasswd file
    # alongside this vhost. ACME challenges below are excluded so
    # LE renewals don't get 401'd.
    auth_basic           "Restricted";
    auth_basic_user_file /etc/nginx/.htpasswd-{{ hosting_id }};
    {%- endif %}

    # Always allow ACME challenges past basic-auth.
    location /.well-known/acme-challenge/ {
        {%- if basic_auth_enabled %}
        auth_basic off;
        {%- endif %}
        alias {{ acme_challenge_root }}/;
        try_files $uri =404;
        default_type "text/plain";
        autoindex off;
    }

    {%- if waf_enabled %}
    # WAF-lite: deny direct access to sensitive files + dumps. These
    # are regex locations, so they're declared before `location ~ \.php$`
    # to win the first-match.
    location = /xmlrpc.php { deny all; }
    location = /wp-config.php { deny all; }
    location = /readme.html { deny all; }
    location = /license.txt { deny all; }
    location ~* \.(sql|bak|old|orig|save|swp|tar|gz|tgz|zip|log|ini|sh)$ { deny all; }
    {%- if has_php %}
    # WAF-lite: block PHP execution under upload + cache dirs (the most
    # common WordPress malware-drop vector).
    location ~* /wp-content/(uploads|cache)/.*\.php$ { deny all; }
    {%- endif %}
    {%- endif %}

    {%- if !wp_admin_allow.is_empty() %}
    # ─── wp-admin IP allowlist (operator-enabled, Settings → Security) ───
    # admin-ajax.php stays public: themes/plugins use it for
    # unauthenticated front-end AJAX (carts, search, contact forms).
    location = /wp-admin/admin-ajax.php {
        {%- if has_php %}
        try_files $uri =404;
        fastcgi_split_path_info ^(.+\.php)(/.+)$;
        fastcgi_pass unix:/run/php/{{ php_version }}/{{ system_user }}.sock;
        fastcgi_index index.php;
        include fastcgi_params;
        fastcgi_param SCRIPT_FILENAME $document_root$fastcgi_script_name;
        fastcgi_read_timeout 3600s;
        {%- endif %}
    }
    location = /wp-login.php {
        {%- for cidr in wp_admin_allow %}
        allow {{ cidr }};
        {%- endfor %}
        deny all;
        {%- if has_php %}
        try_files $uri =404;
        fastcgi_split_path_info ^(.+\.php)(/.+)$;
        fastcgi_pass unix:/run/php/{{ php_version }}/{{ system_user }}.sock;
        fastcgi_index index.php;
        include fastcgi_params;
        fastcgi_param SCRIPT_FILENAME $document_root$fastcgi_script_name;
        fastcgi_read_timeout 3600s;
        {%- endif %}
    }
    location ^~ /wp-admin/ {
        {%- for cidr in wp_admin_allow %}
        allow {{ cidr }};
        {%- endfor %}
        deny all;
        {%- if has_php %}
        location ~ \.php$ {
            {%- for cidr in wp_admin_allow %}
            allow {{ cidr }};
            {%- endfor %}
            deny all;
            try_files $uri =404;
            fastcgi_split_path_info ^(.+\.php)(/.+)$;
            fastcgi_pass unix:/run/php/{{ php_version }}/{{ system_user }}.sock;
            fastcgi_index index.php;
            include fastcgi_params;
            fastcgi_param SCRIPT_FILENAME $document_root$fastcgi_script_name;
            fastcgi_read_timeout 3600s;
        }
        {%- endif %}
    }
    # ─── end wp-admin allowlist ───
    {%- endif %}

    {%- if has_php %}
    location ~ \.php$ {
        try_files $uri =404;
        fastcgi_split_path_info ^(.+\.php)(/.+)$;
        fastcgi_pass unix:/run/php/{{ php_version }}/{{ system_user }}.sock;
        fastcgi_index index.php;
        include fastcgi_params;
        fastcgi_param SCRIPT_FILENAME $document_root$fastcgi_script_name;
        fastcgi_read_timeout 3600s;
        {%- if preview %}
        # Preview vhost: tell the app which host it is actually being
        # served under, so the Hyperion mu-plugin can rewrite WordPress's
        # home/siteurl to THIS name and suppress the canonical redirect
        # that would otherwise bounce every request to the real domain.
        fastcgi_param HYPERION_PREVIEW_HOST $host;
        {%- endif %}
        {%- if fastcgi_cache_enabled %}
        fastcgi_cache hyperion_{{ hosting_id }};
        fastcgi_cache_valid 200 301 302 {{ fastcgi_cache_ttl }}s;
        fastcgi_cache_methods GET HEAD;
        fastcgi_cache_bypass $cookie_wordpress_logged_in $cookie_PHPSESSID;
        fastcgi_no_cache $cookie_wordpress_logged_in $cookie_PHPSESSID;
        fastcgi_cache_key "$scheme$request_method$host$request_uri";
        {#- X-Cache-Status is emitted at SERVER level (see https_body top) —
            an add_header here would drop the inherited security headers. #}
        {%- endif %}
    }
    {%- else %}
    # No PHP runtime on this hosting — so REFUSE .php outright instead of
    # letting it fall through to the static file handler. Without this,
    # nginx serves PHP SOURCE as a download: a visitor to an imported
    # WordPress site whose conversion had not finished yet was offered
    # index.php as a file — and anything else that ends in .php was one
    # request away, credentials included. 404, not 403: a 403 confirms
    # the file exists, which is exactly what a probing crawler wants to
    # know.
    location ~ \.php$ { return 404; }
    {%- endif %}

    location ~ /\.(?!well-known) {
        deny all;
    }

    location / {
        {%- if has_php %}
        try_files $uri $uri/ /index.php?$args;
        {%- else %}
        try_files $uri $uri/ =404;
        {%- endif %}
    }

    {%- if !custom_nginx_snippet.is_empty() %}

    # ─── Custom snippet from operator (Settings → Custom config) ───
    {{ custom_nginx_snippet }}
    # ─── end custom snippet ───
    {%- endif %}
{%- endmacro %}
{%- if maintenance_mode %}
# Maintenance mode toggled ON via /hostings/<domain> detail page.
# Every request returns 503 with a generic page. ACME challenges
# still served so LE renewals don't break.
server {
    listen 80;
    listen [::]:80;
    server_name {{ domain }}{% for a in aliases %} {{ a }}{% endfor %};
    location /.well-known/acme-challenge/ {
        alias {{ acme_challenge_root }}/;
        try_files $uri =404;
        default_type "text/plain";
        autoindex off;
    }
    location / { return 503; }
}
server {
    # `http2` as listen parameter — see nginx-panel.conf.j2 for the
    # rationale. Standalone `http2 on;` only works on nginx ≥ 1.25.1;
    # Debian 12 ships 1.22 and would emit
    # `unknown directive "http2"` on every reload.
    listen 443 ssl http2;
    listen [::]:443 ssl http2;
    server_name {{ domain }}{% for a in aliases %} {{ a }}{% endfor %};
    ssl_certificate     {{ cert_path }};
    ssl_certificate_key {{ key_path }};
    ssl_protocols TLSv1.2 TLSv1.3;
    error_page 503 @maintenance;
    location @maintenance {
        root /var/lib/hyperion/maintenance;
        try_files /maintenance.html =503;
        internal;
        add_header Cache-Control "no-store" always;
        add_header Retry-After "300" always;
    }
    location / { return 503; }
}
{%- else %}
server {
    listen 80;
    listen [::]:80;
    server_name {{ domain }}{% for a in aliases %} {{ a }}{% endfor %};

    # `alias` (not `root`) so nginx serves
    # <acme_challenge_root>/<token>, not
    # <acme_challenge_root>/.well-known/acme-challenge/<token>.
    # The trailing slash on both location and alias is required.
    location /.well-known/acme-challenge/ {
        alias {{ acme_challenge_root }}/;
        try_files $uri =404;
        default_type "text/plain";
        autoindex off;
    }

    location / {
{%- if !canonical_server_name.is_empty() %}
        return 301 https://{{ canonical_server_name }}$request_uri;
{%- else %}
        return 301 https://$host$request_uri;
{%- endif %}
    }
}

{%- if fastcgi_cache_enabled %}
# Per-hosting FastCGI cache (operator-enabled, TTL {{ fastcgi_cache_ttl }}s).
# zone name + path namespaced by hosting_id so multiple hostings on
# the same node don't collide and a Purge button can clear ONE cache
# at a time. The fastcgi_cache_path declaration MUST live at http{}
# level — the agent writes it to /etc/nginx/conf.d/hyperion-cache-{{ hosting_id }}.conf
# parallel to writing the vhost, and the include directive there
# picks it up.
{%- endif %}

server {
    # `http2` as listen parameter — Debian 12 nginx 1.22 doesn't
    # understand standalone `http2 on;`. See top of file for context.
    listen 443 ssl http2;
    listen [::]:443 ssl http2;
    server_name {{ domain }}{% for a in aliases %} {{ a }}{% endfor %};
{%- if !canonical_server_name.is_empty() %}
    # Canonical-host redirect (operator choice: www vs non-www). The
    # `if` is the documented-safe pattern — a bare `return` and nothing
    # else — and beats a separate server block because the alias list
    # stays in ONE place. Sits before any content is served, after the
    # TLS handshake (the cert covers the aliases, so the redirect is
    # served on a valid connection, which a hostname mismatch would not
    # allow).
    if ($host != "{{ canonical_server_name }}") {
        return 301 https://{{ canonical_server_name }}$request_uri;
    }
{%- endif %}
    root {{ root_dir }};
    index index.php index.html index.htm;

    ssl_certificate     {{ cert_path }};
    ssl_certificate_key {{ key_path }};
{%- call https_body(false) %}
}
{%- if preview_enabled %}

# ─── Internal preview vhost (Hyperion) ───
# Serves the SAME docroot/PHP under the node's `*.<base>` wildcard cert
# so an operator can open this site BEFORE pointing real DNS at the
# node. Auto-rendered whenever the node has a wildcard and the primary
# domain isn't already under it; removed with the hosting (same file).
server {
    listen 443 ssl http2;
    listen [::]:443 ssl http2;
    server_name {{ preview_server_name }};
    root {{ root_dir }};
    index index.php index.html index.htm;

    ssl_certificate     {{ preview_cert_path }};
    ssl_certificate_key {{ preview_cert_key_path }};
{%- call https_body(true) %}
}
{%- endif %}
{%- endif %}
