[Unit]
Description=hyperion agent
After=network-online.target nginx.service mariadb.service postgresql.service
Wants=network-online.target

[Service]
Type=simple
ExecStart=/usr/sbin/hyperion-agent --config /etc/hyperion/agent.toml
Restart=on-failure
RestartSec=3s

# Hardening
# No ProtectSystem=, and that is deliberate. "full" and "strict" cover /etc,
# which the agent legitimately writes (/etc/passwd,
# /etc/nginx/sites-available, /etc/php/*/fpm/pool.d, /etc/systemd/system/*)
# as part of provisioning hostings. "true" covers /usr, which it also writes:
# the agent INSTALLS software — OpenDKIM for per-site mail signing, and the
# Services install action — and apt unpacks into /usr/lib, /usr/bin and
# /usr/share. Every install then dies with "Read-only file system" while
# `mount` in the operator's own shell correctly shows / as rw, because the
# sandbox applies only to this unit's children. It reads exactly like a
# corrupt disk and is not one.
#
# ProtectSystem=true plus ReadWritePaths=/usr does NOT work: for the same path
# the read-only mount wins, seen on systemd 257 (Debian 13), with both settings
# showing correctly in `systemctl show`. ReadOnlyPaths= below is what
# ProtectSystem=true would protect, minus /usr. The "-" skips a missing path.
#
# /boot stays read-only, which is the half that matters: the agent has no
# business touching a bootloader or a kernel image, and nothing it does
# ever needs to. The one job that DOES — the panel's OS upgrade, which
# installs kernels into /boot and /lib/modules (hidden by
# ProtectKernelModules below) — is deliberately not run in here: the agent
# starts it with systemd-run as hyperion-node-update.service, a transient
# unit with neither this sandbox nor this cgroup. Do not "fix" a kernel
# upgrade failure by loosening this file. A writable /usr is not a meaningful additional exposure
# here — this unit already creates users and writes unit files, so an
# attacker who controls it has better options than editing a binary.
NoNewPrivileges=true
ReadOnlyPaths=-/boot -/efi
ProtectHome=false
ProtectKernelTunables=true
ProtectKernelModules=true
PrivateTmp=true
LogsDirectory=hyperion
RuntimeDirectory=hyperion
LimitNOFILE=65536

[Install]
WantedBy=multi-user.target
