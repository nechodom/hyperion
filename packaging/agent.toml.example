# Example /etc/linux-manager/agent.toml
#
# Defaults are baked into the binary; every section + key is optional.

[agent]
# Unix socket the CLI talks to. Set group ownership to control access.
socket_path = "/run/linux-manager.sock"
socket_group = "lm-admin"

# SQLite state DB. Created on first boot; migrations applied at startup.
state_db = "/var/lib/linux-manager/state.db"

# Secret files (DB passwords, ACME account key, etc.) — mode 0600 files
# in a 0700 dir. Never persisted in SQLite.
secrets_dir = "/etc/linux-manager/secrets"

# Structured JSON Lines log.
log_path = "/var/log/linux-manager/agent.log"

# Per-system-user homes are created under this dir as
# <home_root>/<system_user>/<domain>/htdocs.
home_root = "/home"

[acme]
# Let's Encrypt production directory by default. Swap for staging when
# testing to avoid rate-limits.
directory_url = "https://acme-v02.api.letsencrypt.org/directory"
# directory_url = "https://acme-staging-v02.api.letsencrypt.org/directory"

# Required by Let's Encrypt — rotate as needed.
contact_email = "admin@example.com"

# Where the HTTP-01 challenge files are written; nginx vhosts serve from
# /.well-known/acme-challenge/ here.
challenge_dir = "/var/lib/linux-manager/acme-challenges"

[enrollment]
# Only a worker node needs this section; install-node.sh writes it.
master_url   = "https://master.example.com"
invite_token = "one-time-token-from-the-master's-Nodes-page"
node_label   = "node5.example.com"

# TLS for the node->master leg: enrollment, and every heartbeat, which
# carries this node's plaintext per-node secret. This is the leg that CAN
# be verified — the master is normally the side holding a CA-issued
# certificate, while a worker's inbound cert is self-signed by design
# (the master pins that one instead).
#
# Three states, and leaving the key OUT is a real one:
#   absent  auto — verify whenever master_url is https:// with a DNS
#           hostname, which is the shape a CA-issued certificate covers.
#           An IP-literal or single-label master URL is not verified,
#           because no public CA certifies one.
#   true    always verify. Use this with an IP-literal master URL when
#           you have installed your own CA on this node.
#   false   the escape hatch for a master serving a self-signed
#           certificate (install-master.sh still ships one). The invite
#           token and this node's secret then cross a channel an on-path
#           attacker can read. Master->node commands stay Ed25519-signed
#           either way; this is about who can READ the exchange.
#
# A failed verification is never retried unverified. The agent aborts and
# logs the fix, so the node goes visibly stale on the master's Nodes page
# instead of silently downgrading to an unauthenticated connection.
# Check the live decision with:
#   journalctl -u hyperion-agent -g 'TLS policy'
# verify_tls = true

# Where the assigned node_id + per-node secret are persisted after the
# first successful enrollment. Its presence is what makes later boots skip
# enrollment.
state_file = "/etc/hyperion/node-id.json"

[fail2ban]
# Native brute-force scanner. Runs every scheduler tick, scans logs +
# journals for auth-failure floods, and auto-bans offenders via nftables.
# Every value below is the default — the whole section is optional.

# Master switch. false = no scanning (manual bans + boot re-apply still work).
enabled = true

# Look-back window applied to every source, in seconds.
window_secs = 600

# Ban duration for a first offence; longer for a repeat offender (an IP with
# a prior ban inside repeat_lookback_secs).
ban_ttl_secs = 3600
repeat_ttl_secs = 86400
repeat_lookback_secs = 86400

# Failures-within-window before a ban, per source. Floored at 2 (a value of
# 0 would ban on the first observed failure):
http_threshold = 12   # POST /wp-login.php | /xmlrpc.php floods (per site)
ssh_threshold  = 8    # sshd auth failures
ftp_threshold  = 8    # vsftpd FAIL LOGIN
mail_threshold = 8    # postfix/dovecot SASL auth failures

# NB: the panel (web UI) login has its own protection — a per-real-peer rate
# limit + firewall ban and a per-account hard-lock — so it is deliberately NOT
# driven from here (the panel's client IP can be a spoofable proxy header).

# [email]
# Outbound mail. With `enabled = false` (the default) postfix delivers
# DIRECTLY to each recipient's MX — no external relay involved. The two
# keys below shape that direct delivery; the rest configure a smart host.
#
# inet_protocols = "ipv4"
#   "ipv4" (default) | "ipv6" | "all". IPv4-only is the deliverability-safe
#   choice for a send-only node: postfix prefers a receiver's AAAA when it
#   has one, and a node whose PTR and SPF cover only its IPv4 address then
#   collects hard rejections from the large receivers with no IPv4 retry.
#   Set "all" once the node has a v6 PTR and every hosted domain's SPF
#   record carries an ip6: term.
#
# bind_address = ""
#   postfix `smtp_bind_address`. Empty (default) lets the kernel choose.
#   Worth setting on a node with more than one public address, where the
#   kernel can otherwise send from an address whose PTR does not match the
#   HELO name and which no SPF record lists.
#
# What Hyperion CANNOT do for you, and what direct delivery depends on:
#   - The PTR (reverse DNS) for this node's IP must equal its `myhostname`.
#     It is set wherever the IP is managed (the provider's console), not
#     here. Settings -> Mail reports whether it matches.
#   - Outbound TCP/25 must not be blocked. Several providers block it by
#     default and unblock on request. Settings -> Mail probes it.
#   - Each hosted domain needs its own DKIM record (per-hosting card) and
#     an SPF record naming this node's IP. Envelope alignment — what makes
#     that SPF record actually get consulted — is switched on for a site
#     when its DKIM is enabled.

# [notifications]
# Editable outbound wording. Every key here is optional, and an empty or
# missing one means "unchanged" — edit them in the panel under
# Settings -> Notifications, which has a live preview.
#
# The first three WRAP what Hyperion already wrote (operator alerts,
# reminders, test sends); their defaults are pass-through:
#   slack_template         = "{message}"   # {message} {time} {panel}
#   email_subject_template = "{subject}"   # {subject} {time}
#   email_body_template    = "{body}"      # {body} {time} {panel} {kind}
#
# The last two are whole letters to the CUSTOMER, and default to EMPTY,
# which means "send the built-in letter". Only the body is editable; the
# subject stays as Hyperion writes it.
#
#   care_report_body_template
#     {domain} {period_start} {period_end} {days}
#     {attacks} {updates} {traffic} {uptime} {backups} {integrity}
#
#     The six section placeholders carry the WHOLE rendered section,
#     already worded — including "not monitored" / "not determined" /
#     "not checked" when that section could not be measured. There is
#     deliberately no placeholder for the bare number behind a section, so
#     no wording can promote something we never measured into a figure.
#
#   expiry_warning_body_template
#     {domain} {expires_at} {days_left} {grace_days} {delete_at} {when}
#
#     Dates and day counts arrive already worded ("1 Sep 2026", "7 days",
#     "1 day", "expires today"), so a custom letter cannot mis-plural a
#     day or name a delete date other than the scheduled one.
#
# A placeholder that does not exist is left in the text exactly as typed —
# never dropped, never an error — so a typo shows up in the preview.
#
# care_report_body_template = """
# CARE REPORT for {domain} ({period_start} – {period_end})
#
# {attacks}
#
# {uptime}
# """
